---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const palette = [
  { name: 'Pizarra', hex: '#1D2326', use: 'Texto principal y superficies oscuras', fg: '#F2F1ED' },
  { name: 'Noche', hex: '#0E171D', use: 'Recorrido virtual, pie de página', fg: '#F2F1ED' },
  { name: 'Caliza', hex: '#E7E6E1', use: 'Fondo general', fg: '#1D2326' },
  { name: 'Papel', hex: '#F2F1ED', use: 'Formularios y fichas', fg: '#1D2326' },
  { name: 'Latón', hex: '#B0915F', use: 'Acento: foco, puntos de interés, estados activos', fg: '#0E171D' },
  { name: 'Musgo', hex: '#6F7B6B', use: 'Datos secundarios y categorías', fg: '#F2F1ED' },
];
const voice = [
  { no: 'Un oasis de lujo inigualable en el corazón de la ciudad.', si: 'Veintidós metros de cristal hacia una terraza con alberca, en el piso 32.' },
  { no: '¡No te pierdas esta oportunidad única!', si: 'Visitas privadas de una hora, de lunes a sábado.' },
  { no: 'Acabados premium de primera calidad.', si: 'Pisos de travertino romano en placas de 120 × 60 cm.' },
];
---
<Base title="La marca — NÓMA" description="Identidad visual de NÓMA: símbolo, paleta, tipografía, voz y movimiento." theme="light">
  <section class="wrap grid gap-12 pb-24 pt-36 md:pt-44 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h1 class="display-xl" data-reveal="lines">La medida de una casa.</h1>
    </div>
    <div class="self-end lg:col-span-4 lg:col-start-9">
      <p class="lede text-grafito">NÓMA viene del griego nómos: la medida, el orden. La identidad toma su forma de la herramienta con la que se dibuja una casa: el plano.</p>
    </div>
  </section>

  <!-- Símbolo -->
  <section class="bg-pizarra py-28 text-papel lg:py-40" aria-labelledby="simbolo-t">
    <div class="wrap grid items-center gap-16 lg:grid-cols-12">
      <figure class="m-0 lg:col-span-6" data-construct>
        <svg viewBox="-6 -6 52 52" class="w-full max-w-xl text-laton-claro" role="img" aria-label="Construcción del símbolo: un muro, el vano de una puerta, su hoja y el arco de giro">
          <g stroke="currentColor" stroke-opacity="0.16" stroke-width="0.12">
            {Array.from({ length: 11 }, (_, i) => <line x1={i * 4} y1="-4" x2={i * 4} y2="44" />)}
            {Array.from({ length: 11 }, (_, i) => <line x1="-4" y1={i * 4} x2="44" y2={i * 4} />)}
          </g>
          <circle cx="7" cy="38" r="26" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="0.15" stroke-dasharray="0.6 0.8" data-c />
          <g fill="none" stroke="#F2F1ED" stroke-width="0.4">
            <path d="M2 2H38V38H33" pathLength="1" data-c-line />
            <path d="M7 38H2V2" pathLength="1" data-c-line />
            <path d="M7 38V12" pathLength="1" data-c-line />
            <path d="M7 12A26 26 0 0 1 33 38" stroke-dasharray="1.6 2.2" data-c-arc />
          </g>
          <g fill="currentColor" font-size="1.6" font-family="Hanken Grotesk Variable, sans-serif" data-c-label>
            <text x="8" y="25">hoja</text>
            <text x="26" y="17">giro de 90°</text>
            <text x="14" y="41.5">vano</text>
            <text x="30" y="5">muro</text>
          </g>
        </svg>
      </figure>
      <div class="lg:col-span-5 lg:col-start-8">
        <h2 id="simbolo-t" class="display-m" data-reveal="lines">Una puerta, dibujada en planta.</h2>
        <p class="lede mt-8 text-bruma">En un plano arquitectónico, la puerta se dibuja como una hoja y el arco que describe al abrirse. Es el primer gesto de entrar a una casa, y es todo lo que hace NÓMA.</p>
        <div class="mt-12 flex flex-wrap items-center gap-10 text-[2rem]">
          <Logo class="text-papel" />
          <Logo symbolOnly class="text-laton-claro" />
        </div>
        <p class="mt-10 font-display text-[clamp(2rem,3vw,3rem)] leading-tight">Arquitectura para quedarse.</p>
        <p class="mt-2 text-sm text-bruma">Eslogan</p>
      </div>
    </div>
  </section>

  <!-- Paleta -->
  <section class="py-28 lg:py-40" aria-labelledby="paleta-t">
    <div class="wrap">
      <div class="mb-14 grid gap-8 lg:grid-cols-12">
        <h2 id="paleta-t" class="display-m lg:col-span-6" data-reveal="lines">Materiales, no colores.</h2>
        <p class="lede self-end text-grafito lg:col-span-5 lg:col-start-8">Cada tono sale de un material de construcción: pizarra, caliza, papel de dibujo, latón y musgo sobre piedra. El latón se usa poco, solo para señalar.</p>
      </div>
      <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
        {palette.map((c) => (
          <li class="swatch group flex aspect-[3/4] flex-col justify-between p-5 ring-1 ring-pizarra/10 transition-[border-radius] duration-700" style={`background:${c.hex};color:${c.fg}`}>
            <span class="font-display text-3xl">{c.name}</span>
            <span class="text-sm"><span class="num block">{c.hex}</span><span class="mt-1 block opacity-75">{c.use}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tipografía -->
  <section class="bg-papel py-28 lg:py-40" aria-labelledby="tipo-t">
    <div class="wrap grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="tipo-t" class="display-m" data-reveal="lines">Dos voces.</h2>
        <p class="mt-6 max-w-[34ch] text-grafito">Italiana para los nombres y los titulares: alta, de trazo fino, como la rotulación de un plano antiguo. Hanken Grotesk para leer y para los datos, con cifras tabulares.</p>
      </div>
      <div class="grid gap-14 lg:col-span-7 lg:col-start-6">
        <div>
          <p class="text-sm text-grafito/70">Italiana, titulares y nombres</p>
          <p class="mt-3 font-display text-[clamp(4rem,10vw,9rem)] leading-[0.85]">Ático Lumen</p>
          <p class="mt-4 font-display text-3xl text-grafito">Aa Bb Cc Ññ Óó 0123456789</p>
        </div>
        <div class="border-t border-pizarra/15 pt-10">
          <p class="text-sm text-grafito/70">Hanken Grotesk, texto y datos</p>
          <p class="mt-3 max-w-[36ch] text-2xl leading-snug">Pisos de travertino romano en placas de 120 × 60 cm, sin juntas visibles.</p>
          <p class="num mt-6 grid grid-cols-3 gap-4 text-lg"><span>308 m²</span><span>Piso 32</span><span>$68,400,000</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Voz -->
  <section class="py-28 lg:py-40" aria-labelledby="voz-t">
    <div class="wrap">
      <h2 id="voz-t" class="display-m max-w-[16ch]" data-reveal="lines">Describimos. No adjetivamos.</h2>
      <ul class="mt-14 grid gap-3">
        {voice.map((v) => (
          <li class="grid gap-4 bg-papel p-6 md:grid-cols-2 md:gap-10 md:p-8">
            <p><span class="block text-sm text-[#a2533c]">Evitamos</span><span class="mt-2 block text-lg text-grafito line-through decoration-1">{v.no}</span></p>
            <p><span class="block text-sm text-musgo">Escribimos</span><span class="mt-2 block font-display text-2xl leading-tight">{v.si}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Movimiento -->
  <section class="bg-noche py-28 text-papel lg:py-40" aria-labelledby="mov-t">
    <div class="wrap grid items-center gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="mov-t" class="display-m" data-reveal="lines">Todo se abre como una puerta.</h2>
        <p class="lede mt-8 text-bruma">Imágenes, páginas, fichas y botones aparecen con un arco que nace en la esquina inferior izquierda, el mismo giro del símbolo. Sin rebotes ni desvanecidos genéricos.</p>
        <button type="button" class="btn btn--light mt-10" data-replay>Ver el movimiento</button>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <div class="relative aspect-[16/10] overflow-hidden bg-grafito">
          <div data-door-demo class="absolute inset-0 grid place-items-center bg-laton-claro text-noche">
            <svg viewBox="0 0 40 40" class="h-24 w-24" aria-hidden="true"><path class="door-symbol" d="M2 2H38V38H33M7 38H2V2M7 38V12" /><path class="door-symbol" d="M7 12A26 26 0 0 1 33 38" stroke-dasharray="1.6 2.2" /></svg>
          </div>
        </div>
        <p class="mt-3 text-sm text-bruma">Curva: cubic-bezier(0.76, 0, 0.24, 1). Duración: 0.9 a 1.6 s según la superficie.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap, onPage, reducedMotion } from '../lib/motion';
  onPage(() => {
    const fig = document.querySelector('[data-construct]');
    if (!fig) return;
    const ctx = gsap.context(() => {
      const replay = () => {
        if (reducedMotion()) return;
        gsap.fromTo('[data-door-demo]', { clipPath: 'circle(0% at 0% 100%)' }, { clipPath: 'circle(142% at 0% 100%)', duration: 1.4, ease: 'power3.inOut' });
      };
      document.querySelector('[data-replay]')?.addEventListener('click', replay);
      if (reducedMotion()) return;
      gsap.set('[data-c-line]', { strokeDasharray: 1, strokeDashoffset: 1 });
      gsap.timeline({ scrollTrigger: { trigger: fig, start: 'top 70%', once: true } })
        .to('[data-c-line]', { strokeDashoffset: 0, duration: 1.4, stagger: 0.25, ease: 'power2.inOut' })
        .from('[data-c-arc]', { rotation: -90, svgOrigin: '7 38', autoAlpha: 0, duration: 1.4, ease: 'power3.inOut' }, '-=0.6')
        .from('[data-c], [data-c-label] text', { autoAlpha: 0, stagger: 0.1, duration: 0.8 }, '-=0.6');
      gsap.from('[data-door-demo]', { clipPath: 'circle(0% at 0% 100%)', duration: 1.4, ease: 'power3.inOut', scrollTrigger: { trigger: '[data-door-demo]', start: 'top 75%', once: true } });
    });
    return () => ctx.revert();
  });
</script>

<style>
  .swatch:hover { border-radius: 0 0 0 9rem; }
</style>
