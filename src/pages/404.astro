---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada — NÓMA" theme="light">
  <section class="wrap grid min-h-[80svh] content-center gap-8 pt-28">
    <svg viewBox="0 0 40 40" class="h-16 w-16 text-laton" aria-hidden="true"><path class="door-symbol" d="M2 2H38V38H2Z" /><path class="door-symbol" d="M7 38V12" /></svg>
    <h1 class="display-l max-w-[14ch]">Esta puerta no lleva a ninguna parte.</h1>
    <p class="lede text-grafito">La dirección no existe o cambió. Vuelve al inicio o explora las residencias.</p>
    <div class="flex flex-wrap gap-3"><a class="btn" href="/residencias">Ver residencias</a><a class="btn btn--ghost" href="/">Ir al inicio</a></div>
  </section>
</Base>
